# ── Como usar ────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com suas chaves reais:
#   cp .env.example .env
#
# NUNCA comite o arquivo .env! Ele já está no .gitignore.

# ── Firebase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Geoapify Places API (https://myprojects.geoapify.com) ──────────────────────
EXPO_PUBLIC_GEOAPIFY_KEY=

# ── Groq AI (https://console.groq.com/keys) ───────────────────────────────────
EXPO_PUBLIC_GROQ_API_KEY=
