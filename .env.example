# ── Como usar ────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com suas chaves reais:
#   cp .env.example .env
#
# NUNCA comite o arquivo .env! Ele já está no .gitignore.

# ── Firebase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
# Web: tipo "Web application" | Redirect URI: https://auth.expo.io/@<expo-username>/<slug>
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android: tipo "Android" | Package: com.dateapp.mobile | SHA-1: via `eas credentials`
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS: tipo "iOS" | Bundle ID: com.dateapp.mobile
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Geoapify Places API (https://myprojects.geoapify.com) ──────────────────────
EXPO_PUBLIC_GEOAPIFY_KEY=

# ── OpenRouter AI (https://openrouter.ai/keys) ────────────────────────────────
# Modelo gratuito: meta-llama/llama-3.3-70b-instruct:free
EXPO_PUBLIC_OPENROUTER_API_KEY=

# ── Google AdMob (console.admob.google.com) ───────────────────────────────────
# App IDs (encontrados em AdMob → Apps → Configurações do app)
# Use os IDs de teste abaixo durante desenvolvimento:
#   Android: ca-app-pub-3940256099942544~3347511713
#   iOS:     ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# Ad Unit IDs (cada formato de anúncio tem um ID diferente)
# IDs de teste Android: Banner=ca-app-pub-3940256099942544/6300978111
#                       Interstitial=ca-app-pub-3940256099942544/1033173712
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
